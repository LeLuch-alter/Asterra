# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys.
# In production set the same variables in Vercel -> Settings -> Environment Variables.

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (public: safe in browser, protected by RLS) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" or new "publishable" key (sb_publishable_...) — NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------- Supabase (server-only, optional: seed/admin scripts only) ----------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI provider (server-only; read ONLY in src/lib/ai/providers/*) ----------
# gemini | openai
AI_PROVIDER=gemini
# GEMINI_API_KEY / OPENAI_API_KEY are accepted as aliases
AI_API_KEY=your-ai-api-key
# e.g. gemini-3.6-flash  or  gpt-4o-mini
AI_MODEL=gemini-3.6-flash

# ---------- Science news (server-only; read ONLY in src/lib/news/*) ----------
# Comma-separated RSS feeds. No key required for RSS.
NEWS_FEED_URLS=https://www.nature.com/nature.rss,https://feeds.arstechnica.com/arstechnica/science,https://www.sciencedaily.com/rss/all.xml
# Optional NewsAPI.org key (free tier ~100 req/day). Used first; RSS feeds are the second source.
# NEWS_API_KEY=
